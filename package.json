{
  "name": "curator-os",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Evidence-first, iPad-first institutional research operating system for Ocean Liner Curator",
  "scripts": {
    "start": "python3 -m http.server 4173",
    "preview": "python3 -m http.server 4173",
    "build:pages": "bash scripts/build-cloudflare-pages.sh",
    "validate": "node scripts/validate.js",
    "test:database": "node tests/database.test.js",
    "test:surface": "node tests/worker-era-findings.test.mjs",
    "test": "npm run test:database && npm run test:surface && npm run test:recovery && npm run test:restore-safety && npm run test:recovery-manifest && npm run test:ops-health && npm run test:device-api",
    "check": "npm run validate && npm run test",
    "recovery:validate": "node scripts/validate-recovery-backup.mjs",
    "test:recovery": "node --test tests/recovery-export.test.mjs",
    "recovery:restore": "node scripts/restore-recovery-backup.mjs",
    "test:restore-safety": "node --test tests/recovery-restore-safety.test.mjs",
    "recovery:manifest:validate": "node scripts/validate-recovery-manifest.mjs",
    "test:recovery-manifest": "node scripts/validate-recovery-manifest.mjs",
    "test:ops-health": "node --test tests/ops-health.test.mjs",
    "test:device-api": "node --test tests/device-api-contract.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
