      "entrypoint": "functions",
      "schedule": [],
      "secrets": [],
      "kvBindings": [
        {
          "binding": "CURATOROS_RECORDS",
          "namespaceId": null,
          "recoveryOwner": "curator-os",
          "recoveryExport": "/api/recovery-export",
          "priority": "critical",
          "notes": "Namespace ID is account-side state and must be verified from the production Pages binding."
        }
      ],
      "recoveryPriority": "critical",
      "serviceBindings": [
        {
          "binding": "CURATOR_OPS",
          "service": "ops",
          "environment": "production",
          "purpose": "Read-only dashboard monitoring summaries",
          "requiredFor": "ops-health dashboard cards",
